{
  "name": "agentlens-for-obsidian",
  "version": "0.1.6",
  "description": "Save public social content as traceable Markdown research notes in Obsidian.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node scripts/build.mjs --target=production --profile=single-fetch-review",
    "build:local": "node scripts/build.mjs --target=local",
    "build:development": "node scripts/build.mjs --target=development",
    "lint": "node scripts/lint.mjs",
    "test": "vitest run",
    "test:activity-export-verifier": "node scripts/test-activity-export-verifier.mjs",
    "test:watch": "vitest",
    "check": "npm run lint && npm run test && npm run test:activity-export-verifier && npm run build",
    "check:development": "npm run lint && npm run test && npm run build:development && npm run package:verify:development",
    "package:verify": "node scripts/verify-package.mjs --target=production --profile=single-fetch-review",
    "package:verify:development": "node scripts/verify-package.mjs --target=development",
    "package:verify:local": "node scripts/verify-package.mjs --target=local",
    "verify:activity-export": "node scripts/verify-activity-export.mjs",
    "build:review": "node scripts/build.mjs --target=production --profile=single-fetch-review",
    "package:verify:review": "node scripts/verify-package.mjs --target=production --profile=single-fetch-review",
    "package:review": "node scripts/package-review.mjs",
    "scan:source": "eslint src --max-warnings=0",
    "package:release": "node scripts/package-release.mjs"
  },
  "dependencies": {
    "http-proxy-agent": "7.0.2",
    "https-proxy-agent": "7.0.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "socks-proxy-agent": "8.0.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/node": "22.15.17",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "esbuild": "0.25.5",
    "fake-indexeddb": "6.2.5",
    "eslint": "9.39.4",
    "eslint-plugin-obsidianmd": "0.4.2",
    "jsdom": "29.1.1",
    "obsidian": "1.13.1",
    "typescript": "5.8.3",
    "typescript-eslint": "8.71.2",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=20"
  }
}
